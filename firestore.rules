rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || (
            request.auth.token.firebase.sign_in_provider == 'microsoft.com'
            && request.auth.token.email.matches('.*@starsmicro\\.com$')
          )
        );
    }

    function head() {
      return signedIn()
        && request.auth.token.email == 'tuchapong-ki@starsmicro.com';
    }

    function dashboardViewer() {
      return signedIn()
        && request.auth.token.email == 'trackertda@gmail.com';
    }

    match /pjt/{uid} {
      // Employees read their own data; head and dashboard account can read all.
      allow read: if signedIn()
        && (request.auth.uid == uid || head() || dashboardViewer());

      // Dashboard-only account cannot create, edit, or delete project/profile data.
      allow write: if signedIn()
        && request.auth.uid == uid
        && !dashboardViewer();
    }

    // Work photos are stored separately from the project list to avoid
    // exceeding Firestore's 1 MiB document limit.
    match /pjt/{uid}/projectImages/{imageId} {
      allow read: if signedIn()
        && (request.auth.uid == uid || head() || dashboardViewer());

      allow create, update, delete: if signedIn()
        && request.auth.uid == uid
        && !dashboardViewer();
    }
  }
}
